# ---- Claude (the "brain": topic research, script, art direction, QA) ----
# Uses your Claude subscription through the Claude Code CLI in headless mode.
# Run `claude setup-token` once (see README) and paste the token here.
CLAUDE_CODE_OAUTH_TOKEN=
# Optional: full path to claude.exe. Auto-detected from the Claude desktop app if empty.
CLAUDE_BIN=
# Model for planning/script (opus | sonnet | haiku or a full model id)
CLAUDE_MODEL=opus
# Model for cheap steps (QA review of stills)
CLAUDE_FAST_MODEL=sonnet

# ---- Stock footage / photos (free, commercial use OK): https://www.pexels.com/api/ ----
PIXABAY_API_KEY=
PEXELS_API_KEY=

# ---- YouTube (OAuth Desktop client from Google Cloud console, YouTube Data API v3 enabled) ----
YOUTUBE_CLIENT_ID= 
YOUTUBE_CLIENT_SECRET=
# Optional: a YouTube Data API key for trending discovery (videos.list mostPopular)
YOUTUBE_API_KEY=

# ---- Voice ----
# edge (free, default) | google (Google Cloud TTS; needs GOOGLE_TTS_API_KEY)
TTS_ENGINE=edge
GOOGLE_TTS_API_KEY=

# ---- Paths (auto-detected if empty) ----
CHROME_PATH=
FFMPEG_PATH=
PYTHON_PATH=

# ---- Server ----
PORT=3020
# Protects the dashboard if you ever expose it beyond localhost
DASHBOARD_PASSWORD=

# ---- Facebook Page (Reels): a Meta app (developers.facebook.com) with Facebook Login for Business ----
FB_APP_ID=
FB_APP_SECRET=
# Graph API version (optional)
FB_GRAPH_VERSION=v26.0
